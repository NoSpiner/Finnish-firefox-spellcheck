{
  "manifest_version": 3,
  "name": "Finnish spellcheck",
  "version": "1.0",
  "description": "Adds a custom Finnish Hunspell dictionary for spellchecking.",
  "dictionaries": {
    "fi-FI": "dictionaries/fi_FI.dic"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fi_spellcheck@example.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
